---
import { getContent, whatsappLink, telLink } from '../content';
import WhatsAppIcon from './icons/WhatsApp.astro';

const { site, copy } = await getContent();
---

<div
  class="pointer-events-none fixed inset-x-0 bottom-0 z-40 flex justify-center p-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))] md:hidden"
  aria-hidden="false"
>
  <div class="pointer-events-auto flex w-full max-w-md gap-2 rounded-2xl border border-primary/10 bg-background/95 p-2 shadow-lg backdrop-blur">
    <a
      href={telLink()}
      data-track="call"
      data-placement="sticky"
      class="btn inline-flex flex-1 items-center justify-center rounded-xl bg-primary px-4 py-3 text-sm font-semibold text-primary-foreground"
    >
      {copy.nav.call}
    </a>
    <a
      href={whatsappLink(copy.waMessages.default)}
      data-track="whatsapp"
      data-placement="sticky"
      class="btn btn-accent inline-flex flex-1 items-center justify-center gap-1.5 rounded-xl bg-accent px-4 py-3 text-sm font-semibold text-accent-foreground"
    >
      <WhatsAppIcon class="h-5 w-5" />
      WhatsApp
    </a>
  </div>
</div>
