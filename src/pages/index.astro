---
/**
 * The single page.
 *
 * Each section is a component that reads from the content adapter —
 * so this file is just the running order of the argument.
 */
import Layout from '../layouts/Layout.astro';
import { getContent } from '../content';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import SoloTravel from '../components/SoloTravel.astro';
import Vehicles from '../components/Vehicles.astro';
import Activities from '../components/Activities.astro';
import Routes from '../components/Routes.astro';
import Stays from '../components/Stays.astro';
import Pricing from '../components/Pricing.astro';
import Reviews from '../components/Reviews.astro';
import Contact from '../components/Contact.astro';
import Motion from '../components/Motion.astro';
import RiverDivider from '../components/RiverDivider.astro';

/**
 * Band colours for the river dividers. A divider is only placed where
 * the background actually changes — using one between two bands of
 * the same colour would be decoration for its own sake.
 *
 * hero(deep) │ solo(bg) │ cars(muted) │ activities(bg) │ routes(muted)
 *            │ stays(bg) │ pricing(bg) │ reviews(primary) │ contact(deep)
 */
/**
 * Title and description come from Sanity, not from this file.
 *
 * They used to be hardcoded here while siteSettings.seo sat in the
 * Studio reading authoritative and rendering nowhere — the same
 * drift as the dead `hoursConfirmed` flag. An editor changing the
 * description in the Studio now changes the page.
 */
const { site } = await getContent();

/* Band colours live in src/styles/bands.ts and the divider resolves
   them by name, so no page repeats a hex. */
---

<Layout title={site.seo.title} description={site.seo.description}>
  <Nav />
  <Hero />
  <RiverDivider from="deep" to="bg" />
  <main id="main">
    <SoloTravel />
    <Vehicles />
    <Activities />
    <Routes />
    <Stays />
    <Pricing />
    <RiverDivider from="bg" to="primary" />
    <Reviews />
  </main>
  <RiverDivider from="primary" to="deep" />
  <Contact />
  <Motion />
</Layout>
