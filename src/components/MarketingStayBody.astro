---
import Carousel from './Carousel.astro';
import type { Stay } from '../content/stays';
import type { Img } from '../content';

interface Props {
  stay: Stay & { photos: Img[] };
}
const { stay } = Astro.props;
---

{stay.photos.length > 0 && (
  <div class="reveal mt-10">
    <div class="img-frame rounded-lg">
      <Carousel
        photos={stay.photos}
        label={stay.kind}
        sizes="(min-width: 768px) 70vw, 90vw"
        aspect="aspect-[16/10]"
      />
    </div>
    <p class="measure mt-4 text-sm text-muted-foreground">{stay.blurb}</p>
  </div>
)}
