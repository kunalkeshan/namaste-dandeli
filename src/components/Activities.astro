---
import Section from './Section.astro';
import CommonsImage from './CommonsImage.astro';
import { getContent } from '../content';
const { activities, images, copy } = await getContent();

/* Images paired to the activities that have a genuine Dandeli photo. */
const art: Record<string, (typeof images)[keyof typeof images] | undefined> = {
  'White water rafting': images.kaliHabitat,
  'Coracle ride': images.coracle,
  Birdwatching: images.hornbill,
  'Syntheri Rocks': images.syntheri,
  'Supa Dam & Sykes Point': images.sykesPoint,
  // riverDawn is kept for the Stays section, where atmosphere is the point.
  'Jungle safari': images.forestRoad,
};
---

<Section
  id="dandeli"
  eyebrow={copy.sections.activities.eyebrow}
  title={copy.sections.activities.title}
  lede={copy.sections.activities.lede}
>
  <div class="reveal grid gap-x-8 gap-y-12 sm:grid-cols-2">
    {activities.map((a) => {
      const img = art[a.name];
      return (
        <article class="reveal-child">
          {img && (
            <div class="img-frame mb-5 rounded-lg">
              <CommonsImage
                img={img}
                sizes="(min-width: 640px) 44vw, 90vw"
                aspect="aspect-[5/3]"
                class="w-full"
              />
            </div>
          )}
          <h3 class="text-xl">{a.name}</h3>
          <p class="mt-2.5 text-muted-foreground">{a.blurb}</p>

          {(a.duration || a.season) && (
            <dl class="mt-4 flex flex-wrap gap-x-6 gap-y-1 text-sm">
              {a.duration && (
                <div class="flex gap-2">
                  <dt class="text-muted-foreground">Takes</dt>
                  <dd class="font-medium">{a.duration}</dd>
                </div>
              )}
              {a.season && (
                <div class="flex gap-2">
                  <dt class="text-muted-foreground">Season</dt>
                  <dd class="font-medium">{a.season}</dd>
                </div>
              )}
            </dl>
          )}

          {a.caveat && (
            <p class="mt-4 border-l-2 border-accent pl-4 text-sm text-muted-foreground">
              {a.caveat}
            </p>
          )}
        </article>
      );
    })}
  </div>
</Section>
