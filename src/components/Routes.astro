---
/**
 * Routes.
 *
 * Reframed from "here are fixed airport transfers" to "any trip is
 * planned with Irshad" — which is what the reviews actually show.
 * The 1600 km Dandeli–Mysore–Ooty week and the Kumta–Udupi–
 * Murudeshwar–Mangalore run are real customer trips, so this is
 * evidence rather than a claim.
 *
 * ⚠️ Distances render ONLY when route.verified is true. See
 * content/routes.ts for why that rule exists.
 */
import Section from './Section.astro';
import { getContent, whatsappLink } from '../content';
const { routes, outstation, site, reviews } = await getContent();

const longTrip = reviews.find((r) => r.role === 'long-distance');
/* Doubled so the marquee can loop seamlessly at -50%. */
const chips = [...outstation, ...outstation];
---

<Section
  id="getting-here"
  eyebrow="Getting there and back"
  title="Anywhere you need to be, worked out on the phone"
  lede="These are the arrivals people book most often. But the trip is whatever you and Irshad plan together — a single airport run, a week of driving, or a route nobody has asked for before."
  tone="muted"
>
  <ul class="divide-y divide-border border-y border-border reveal">
    {routes.map((r) => (
      <li class="reveal-child flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-4">
        <div>
          <span class="font-medium">{r.from}</span>
          <span class="mx-2 text-muted-foreground" aria-hidden="true">→</span>
          <span class="text-muted-foreground">{r.to}</span>
          {r.note && <p class="mt-1 text-sm text-muted-foreground">{r.note}</p>}
        </div>
        {r.verified && r.km && r.drive ? (
          <span class="text-sm tabular-nums text-muted-foreground">
            {r.km} km &middot; about {r.drive}
          </span>
        ) : (
          <a
            href={`tel:${site.phone}`}
            class="link-inline text-sm font-medium text-accent-ink underline decoration-accent underline-offset-4 transition-colors hover:text-foreground hover:no-underline"
          >
            Ask the fare
          </a>
        )}
      </li>
    ))}
  </ul>

  <!-- the proof that "anywhere" is not marketing -->
  {longTrip && (
    <figure class="reveal mt-12 border-l-2 border-accent pl-5">
      <blockquote>
        <p class="measure font-display text-xl leading-snug">
          &ldquo;A week Ride with Ertiga from Dandeli-Mysore-Ooty 1600KM up and down&rdquo;
        </p>
      </blockquote>
      <figcaption class="mt-2.5 text-sm text-muted-foreground">
        {longTrip.author} &middot; on Google
      </figcaption>
    </figure>
  )}

  <div class="reveal mt-10">
    <h3 class="font-display text-lg">Places he has already driven people</h3>
    <p class="mt-2 text-sm text-muted-foreground">
      Every one of these comes out of his reviews — real trips, not a brochure list.
    </p>
    <div class="marquee mt-5" role="list" aria-label="Destinations Irshad has driven to">
      <div class="marquee-track">
        {chips.map((d, i) => (
          <span
            role="listitem"
            aria-hidden={i >= outstation.length ? 'true' : undefined}
            class="shrink-0 rounded-full border border-border px-3.5 py-1.5 text-sm"
          >
            {d}
          </span>
        ))}
      </div>
    </div>
  </div>

  <a
    href={whatsappLink('Hello Irshad, I would like to plan a trip.\n\nFrom: \nTo: \nDates: \nNumber of people: ')}
    target="_blank"
    rel="noopener"
    class="btn btn-primary reveal mt-10 inline-flex items-center justify-center rounded-xl bg-primary px-6 py-3.5 font-semibold text-primary-foreground"
  >
    Plan a trip with Irshad
  </a>
</Section>
