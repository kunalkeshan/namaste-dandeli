---
import { getContent, whatsappLink } from '../content';
import WhatsAppIcon from './icons/WhatsApp.astro';

interface Props {
  message: string;
  label?: string;
}
const { message, label = 'Message Irshad on WhatsApp' } = Astro.props;
const { site } = await getContent();
---

<div class="reveal flex flex-col items-start gap-3 sm:flex-row sm:items-center">
  <a
    href={whatsappLink(message)}
    data-track="whatsapp"
    data-placement="inline"
    class="btn btn-accent inline-flex items-center justify-center gap-2 rounded-xl bg-accent px-6 py-3.5 font-semibold text-accent-foreground"
  >
    <WhatsAppIcon class="h-5 w-5" />
    {label}
  </a>
  <p class="text-sm text-muted-foreground">
    Or call{' '}
    <a
      class="link-inline"
      href={`tel:${site.phone}`}
      data-track="call"
      data-placement="inline"
    >
      {site.phoneDisplay}
    </a>
  </p>
</div>
