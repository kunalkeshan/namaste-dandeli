---
import type { FaqItem } from '../content';
import ChevronDown from './icons/ChevronDown.astro';

interface Props {
  faqs: FaqItem[];
}
const { faqs } = Astro.props;
if (!faqs.length) return null;
---

<section class="reveal" aria-labelledby="faq-heading">
  <h2 id="faq-heading" class="text-xl">
    Questions from travellers
  </h2>
  <div class="faq-accordion measure mt-6 flex flex-col gap-3" data-faq-accordion>
    {faqs.map((f) => (
      <details class="faq-accordion__item reveal-child">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-4 px-4 py-3.5 text-left font-semibold text-foreground transition-colors hover:text-primary [&::-webkit-details-marker]:hidden">
          <span class="faq-question pr-2">{f.question}</span>
          <ChevronDown class="faq-accordion__chevron mt-0.5 shrink-0 text-muted-foreground" />
        </summary>
        <div class="faq-accordion__panel">
          <p class="faq-answer px-4 pb-4 text-muted-foreground">{f.answer}</p>
        </div>
      </details>
    ))}
  </div>
</section>

<style>
  .faq-accordion__item {
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--color-muted) 55%, var(--color-background));
    transition:
      border-color 280ms var(--ease-in-out-strong),
      box-shadow 280ms var(--ease-in-out-strong);
  }

  @media (hover: hover) {
    .faq-accordion__item:has(summary:hover) {
      border-color: color-mix(in srgb, var(--color-border) 70%, var(--color-primary));
      box-shadow: 0 4px 14px rgb(18 32 25 / 0.06);
    }
  }

  .faq-accordion__item[open] {
    border-color: color-mix(in srgb, var(--color-border) 50%, var(--color-primary));
    box-shadow: 0 6px 20px rgb(18 32 25 / 0.08);
    background: var(--color-background);
  }

  .faq-accordion__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 280ms var(--ease-in-out-strong);
  }

  .faq-accordion__item[open] .faq-accordion__panel {
    grid-template-rows: 1fr;
  }

  .faq-accordion__panel > * {
    min-height: 0;
    overflow: hidden;
  }

  .faq-accordion__chevron {
    transition: transform 280ms var(--ease-in-out-strong);
  }

  .faq-accordion__item[open] .faq-accordion__chevron {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-accordion__panel {
      transition-duration: 0.01ms;
    }
    .faq-accordion__chevron {
      transition-duration: 0.01ms;
    }
  }
</style>

<script is:inline>
  (() => {
    /* data-faq-accordion-ready */
    const roots = document.querySelectorAll('[data-faq-accordion]');
    if (!roots.length) return;
    for (const root of roots) {
      root.addEventListener(
        'toggle',
        (e) => {
          const t = e.target;
          if (!(t instanceof HTMLDetailsElement) || !t.open || !root.contains(t)) return;
          root.querySelectorAll('details[open]').forEach((d) => {
            if (d !== t) d.open = false;
          });
        },
        true,
      );
    }
  })();
</script>
