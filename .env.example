# Sanity. Project krbamcti, dataset production.
# Copy to .env.local (gitignored) and fill in the token.

# Not secret — these appear in every *.sanity.studio URL.
SANITY_PROJECT_ID=krbamcti
SANITY_DATASET=production

# SECRET. Create at sanity.io/manage -> API -> Tokens.
# Viewer permission is enough for the site build (reads published docs).
# An Editor token is needed only for the one-off asset upload script.
# Never prefix PUBLIC_ — that would inline it into the built HTML.
SANITY_API_READ_TOKEN=
