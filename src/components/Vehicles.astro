---
/**
 * The fleet.
 *
 * Cars are local cutout WebPs served from /public, so they are NOT
 * routed through CommonsImage — width/height are set inline to
 * reserve space and prevent layout shift.
 */
import Section from './Section.astro';
import { getContent } from '../content';
const { vehicles, carImages, carImageNote } = await getContent();
---

<Section
  id="cars"
  eyebrow="The cars"
  title="Three vehicles, so you are not paying for seats you do not need"
  tone="muted"
>
  <div class="reveal grid gap-6 sm:grid-cols-3">
    {vehicles.map((v) => {
      const img = carImages[v.kind];
      return (
        <article class="reveal-child group flex flex-col overflow-hidden rounded-xl border border-border bg-background">
          <div class="flex items-center justify-center bg-gradient-to-b from-muted to-background px-4 pt-6 pb-2">
            <img
              src={img.src}
              width={img.width}
              height={img.height}
              alt={img.alt}
              loading="lazy"
              decoding="async"
              class="h-32 w-auto object-contain transition-transform duration-500 ease-out motion-safe:group-hover:-translate-y-1 motion-safe:group-hover:scale-[1.04]"
            />
          </div>
          <div class="flex flex-1 flex-col gap-0 p-6 pt-4">
            <h3 class="text-xl">{v.name}</h3>
            <p class="decal mt-1.5 text-xs text-accent-ink">{v.seats}</p>
            <p class="mt-3 text-muted-foreground">{v.suits}</p>
            <p class="mt-auto border-t border-rule pt-4 text-sm text-muted-foreground">{v.note}</p>
          </div>
        </article>
      );
    })}
  </div>

  <p class="reveal mt-6 text-sm text-muted-foreground">{carImageNote}</p>
</Section>
