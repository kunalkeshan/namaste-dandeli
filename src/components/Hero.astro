---
/**
 * The hero.
 *
 * Art direction: "the page is the object". Irshad's logo lives on a
 * rear windscreen, so the hero is built as that windscreen — the
 * monogram sitting on glass with the forest showing through, the
 * wordmark set above it in the decal's own voice.
 *
 * That is why this is not a full-bleed photo with centred text: every
 * cab site in India is a full-bleed photo with centred text.
 */
import Logo from './Logo.astro';
import CommonsImage from './CommonsImage.astro';
import ForestTexture from './ForestTexture.astro';
import { getContent, whatsappLink, telLink } from '../content';

const { site, images, reviews, copy } = await getContent();

/* The hero quote is NOT the solo-travel one — that has its own section
   further down, and running the same quote twice weakens both. */
const heroQuote = reviews.find((r) => r.role === 'local-knowledge')!;
---

<header
  id="top"
  class="relative flex min-h-[100svh] flex-col justify-center overflow-hidden bg-primary-deep text-primary-foreground"
>
  <!-- the view through the glass -->
  <CommonsImage
    img={images.rafting}
    priority
    sizes="100vw"
    class="absolute inset-0 h-full w-full object-cover opacity-[0.6]"
  />
  <div class="absolute inset-0 bg-gradient-to-b from-primary-deep/75 via-primary-deep/55 to-primary-deep"></div>
  <ForestTexture opacity={0.045} />

  <div class="relative mx-auto w-full max-w-5xl px-5 pt-[calc(var(--nav-h,64px)+1.5rem)] pb-10">
    <!-- the decal, as it sits on the car -->
    <div class="flex flex-col items-center text-center">
      <p class="decal text-sm sm:text-base text-primary-foreground/90">
        {copy.hero.wordmark}
      </p>
      <Logo class="mt-3 w-[clamp(4.5rem,9vh,7rem)] text-primary-foreground" />
      <p class="decal mt-2 text-[0.65rem] sm:text-xs text-primary-foreground/55">
        {copy.hero.place}
      </p>
    </div>

    <h1 class="mt-[clamp(1.25rem,3.5vh,2.5rem)] text-center font-display text-[clamp(1.6rem,0.7rem+3.4vw+1.5vh,4.5rem)] text-primary-foreground">
      {copy.hero.headline[0]}
      <br />
      {copy.hero.headline[1]}
    </h1>

    <p class="measure mx-auto mt-[clamp(0.6rem,2vh,1.25rem)] text-center text-[clamp(0.875rem,0.8rem+0.35vh,1.1875rem)] text-primary-foreground/85">
      {copy.hero.lede}
    </p>

    <!-- proof, stated plainly and linked so anyone can check it -->
    <div class="mt-[clamp(1rem,2.5vh,1.5rem)] flex justify-center">
      <a
        href={site.google.mapsUrl}
        target="_blank"
        rel="noopener"
        class="btn btn-ghost group inline-flex items-center gap-2.5 rounded-full border border-primary-foreground/25 bg-primary-foreground/10 px-4 py-2.5 text-[0.8rem] whitespace-nowrap sm:gap-3 sm:px-5 sm:text-sm"
      >
        <span aria-hidden="true" class="text-accent-bright">
          ★★★★★
        </span>
        <span>
          <strong class="font-semibold">{site.google.rating}</strong>{' '}
          <span class="hidden xs:inline">from </span>
          {site.google.reviewCountLabel} reviews
          <span class="hidden sm:inline"> on Google</span>
        </span>
        <span
          aria-hidden="true"
          class="opacity-50 transition group-hover:translate-x-0.5"
        >
          ›
        </span>
      </a>
    </div>

    <!-- the decision point -->
    <div class="mt-[clamp(1.25rem,3vh,1.75rem)] flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
      <a
        href={whatsappLink(copy.waMessages.default)}
        target="_blank"
        rel="noopener"
        class="btn btn-accent inline-flex w-full items-center justify-center gap-2 rounded-xl bg-accent px-7 py-4 text-base font-semibold text-accent-foreground shadow-lg sm:w-auto"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.64-2.05-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.7.63.71.23 1.36.2 1.87.12.57-.09 1.75-.72 2-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.3-1.39a9.86 9.86 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.44 9.9-9.9S17.5 2 12.04 2" />
        </svg>
        {copy.hero.whatsappCta}
      </a>
      <a
        href={telLink()}
        class="btn btn-ghost inline-flex w-full items-center justify-center gap-2 rounded-xl border border-primary-foreground/30 px-7 py-4 text-base font-semibold sm:w-auto"
      >
        Call {site.phoneDisplay}
      </a>
    </div>

    <!-- the strongest trust signal on the page, where the decision happens -->
    <figure class="measure-tight mx-auto mt-[clamp(0.75rem,2.5vh,2rem)] hidden text-center min-[360px]:block">
      <blockquote class="text-primary-foreground/90">
        <p class="text-[0.95rem] leading-relaxed">
          &ldquo;{heroQuote.pull ?? heroQuote.text}&rdquo;
        </p>
      </blockquote>
      <figcaption class="mt-2.5 text-xs text-primary-foreground/55">
        {heroQuote.author} &middot; five stars on Google
      </figcaption>
    </figure>
  </div>
</header>
