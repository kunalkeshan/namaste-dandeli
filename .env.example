# Sanity. Project krbamcti, dataset production.
# Copy to .env.local (gitignored) and fill in the token.

# Not secret — these appear in every *.sanity.studio URL.
SANITY_PROJECT_ID=krbamcti
SANITY_DATASET=production

# NO TOKEN REQUIRED.
#
# The production dataset is public, so the build reads it unauthenticated
# — verified against the API. Asset uploads use the session that
# `sanity login` creates, not a token.
#
# If the dataset is ever made private, add a Viewer token here and set
# the same value in Vercel. Never prefix it PUBLIC_: that would inline
# the secret into the built HTML.
# SANITY_API_READ_TOKEN=
