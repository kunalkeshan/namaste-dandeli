---
import { getContent } from '../../content';
import MarketingDocument from '../../components/MarketingDocument.astro';

export async function getStaticPaths() {
  const { marketingChildren, stays } = await getContent();
  return marketingChildren('stays').map((page) => ({
    params: { slug: page.slug },
    props: {
      page,
      stay: page.stayKind ? (stays.find((s) => s.kind === page.stayKind) ?? null) : null,
    },
  }));
}

const { page, stay } = Astro.props;
const { staysBeforeYouBook } = await getContent();
const withDisclosure = {
  ...page,
  sections: [...page.sections, { heading: 'Before you book', body: staysBeforeYouBook }],
};
---

<MarketingDocument
  page={withDisclosure}
  stay={stay}
  breadcrumbs={[{ name: 'Stays', href: '/stays' }, { name: page.pageTitle }]}
/>
