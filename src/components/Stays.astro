---
/**
 * Stays — deliberately unnamed.
 *
 * Naming a partner resort means the guest books it direct and Irshad
 * loses the introduction he made. So the grid sorts by what the stay
 * is LIKE, which is what a guest is choosing between anyway.
 *
 * The disclosure is body text, not small print: the photographs show
 * the region, not the properties, and the page says so plainly.
 */
import Section from './Section.astro';
import WhatsAppIcon from './icons/WhatsApp.astro';
import Carousel from './Carousel.astro';
import { getContent } from '../content';
const { stays, staysDisclosure, copy, whatsappLink } = await getContent();
---

<Section
  id="stay"
  eyebrow={copy.sections.stays.eyebrow}
  title={copy.sections.stays.title}
  lede={copy.sections.stays.lede}
>
  <!-- A grid of cards, each with its OWN carousel of that kind of
       property. Previously a single outer rail indexed a shared image
       array by POSITION (art[i]), so a fourth stay crashed the build;
       photographs now live on the stay document itself. -->
  <div class="reveal grid gap-6 sm:grid-cols-3">
    {stays.map((s) => (
      <article class="reveal-child">
        <div class="img-frame rounded-lg">
          <Carousel
            photos={s.photos}
            label={s.kind}
            sizes="(min-width: 640px) 30vw, 90vw"
            aspect="aspect-[4/3]"
          />
        </div>
        <h3 class="mt-4 text-lg font-display">{s.kind}</h3>
        <p class="mt-1.5 text-sm text-muted-foreground">{s.blurb}</p>
      </article>
    ))}
  </div>

  <p class="measure reveal mt-10 border-l-2 border-border pl-4 text-sm text-muted-foreground">
    {staysDisclosure}
  </p>

  <a
    href={whatsappLink(copy.waMessages.stay)}
    target="_blank"
    rel="noopener"
    class="link-inline mt-6 inline-flex items-center gap-2 font-medium text-accent-ink underline decoration-accent decoration-2 underline-offset-4 hover:no-underline"
  >
    <WhatsAppIcon size={16} class="shrink-0 [text-decoration:none]" />
    {copy.sections.stays.cta}
  </a>
</Section>
