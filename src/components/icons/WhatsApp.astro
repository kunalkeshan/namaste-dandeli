---
/**
 * The WhatsApp glyph.
 *
 * THE OFFICIAL MARK, from Simple Icons (CC0 — public domain, no
 * attribution required). `source/whatsapp.svg` is the file as
 * downloaded; this component is that path and nothing else.
 *
 * It replaced a hand-simplified path that had been inlined in
 * Hero.astro. That one drew the handset as a separate filled shape
 * rather than a cut-out, so at 16–20px the detail filled in and the
 * mark read as a generic speech bubble — recognisably not WhatsApp,
 * which defeats the only reason to draw it. Do not "optimise" this
 * path; re-download it.
 *
 * `aria-hidden` BY DEFAULT, and every call site must keep its visible
 * text label. The glyph repeats what the words already say, so naming
 * it too would announce the button twice. `pnpm verify:aria` fails any
 * link whose entire content is aria-hidden, which is the guard that
 * stops a call site dropping the text and leaving a nameless button.
 *
 * `fill="currentColor"`: it inherits the button's text colour, so the
 * same component is correct on accent, on primary and on the light
 * band with no per-site override — and it can never reach for brand
 * red, which `verify-content` counts.
 *
 * Compile-time only. Astro inlines this into the HTML at build, so it
 * ships zero bytes of JavaScript and the zero-JS gate stays green.
 */
interface Props {
  /** px, square. 15 in the nav, 18–20 on a button, 16 inline. */
  size?: number;
  class?: string;
}

const { size = 20, class: className } = Astro.props;
---

<svg
  class={className || undefined}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
>
