---
/**
 * The hero.
 *
 * Art direction: "the page is the object". Irshad's logo lives on a
 * rear windscreen, so the hero is built as that windscreen — the
 * monogram sitting on glass with the forest showing through, the
 * wordmark set above it in the decal's own voice.
 *
 * That is why this is not a full-bleed photo with centred text: every
 * cab site in India is a full-bleed photo with centred text.
 */
import Logo from './Logo.astro';
import CommonsImage from './CommonsImage.astro';
import { getContent, whatsappLink, WA_DEFAULT } from '../content';

const { site, images, reviews } = await getContent();

/* The hero quote is NOT the solo-travel one — that has its own section
   further down, and running the same quote twice weakens both. */
const heroQuote = reviews.find((r) => r.role === 'local-knowledge')!;
---

<header class="relative overflow-hidden bg-primary-deep text-primary-foreground">
  <!-- the view through the glass -->
  <CommonsImage
    img={images.rafting}
    priority
    sizes="100vw"
    class="absolute inset-0 h-full w-full object-cover opacity-[0.6]"
  />
  <div class="absolute inset-0 bg-gradient-to-b from-primary-deep/75 via-primary-deep/55 to-primary-deep"></div>

  <div class="relative mx-auto max-w-5xl px-5 pt-8 pb-12 sm:pt-10 sm:pb-16">
    <!-- the decal, as it sits on the car -->
    <div class="flex flex-col items-center text-center">
      <p class="decal text-sm sm:text-base text-primary-foreground/90">Namaste Dandeli</p>
      <Logo class="mt-3 w-28 sm:w-36 text-primary-foreground" />
      <p class="decal mt-2 text-[0.65rem] sm:text-xs text-primary-foreground/55">
        Alur &middot; Dandeli &middot; Karnataka
      </p>
    </div>

    <h1 class="mt-8 sm:mt-10 text-center font-display text-[clamp(2.4rem,1.4rem+4.4vw,4.75rem)] text-primary-foreground">
      One person who knows<br />the whole of Dandeli
    </h1>

    <p class="measure mx-auto mt-5 text-center text-lg text-primary-foreground/85">
      Irshad has been driving this forest for years — to the rafting point at
      Ganeshgudi, through the tiger reserve at first light, and to the resort
      that actually suits your group. One call arranges the car, the activity
      and the stay.
    </p>

    <!-- proof, stated plainly and linked so anyone can check it -->
    <div class="mt-6 flex justify-center">
      <a
        href={site.google.mapsUrl}
        target="_blank"
        rel="noopener"
        class="group inline-flex items-center gap-3 rounded-full border border-primary-foreground/25 bg-primary-foreground/10 px-5 py-2.5 text-sm transition hover:bg-primary-foreground/15"
      >
        <span aria-hidden="true" class="text-accent-bright">★★★★★</span>
        <span>
          <strong class="font-semibold">{site.google.rating}</strong>{' '}from {site.google.reviewCount} reviews on Google
        </span>
        <span aria-hidden="true" class="opacity-50 transition group-hover:translate-x-0.5">›</span>
      </a>
    </div>

    <!-- the decision point -->
    <div class="mt-7 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
      <a
        href={whatsappLink(WA_DEFAULT)}
        target="_blank"
        rel="noopener"
        class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-accent px-7 py-4 text-base font-semibold text-accent-foreground shadow-lg transition hover:brightness-110 active:scale-[0.99] sm:w-auto"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.47 14.38c-.3-.15-1.75-.86-2.02-.96-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.64-2.05-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.22 3.08c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.7.63.71.23 1.36.2 1.87.12.57-.09 1.75-.72 2-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.3-1.39a9.86 9.86 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.44 9.9-9.9S17.5 2 12.04 2" />
        </svg>
        Message Irshad on WhatsApp
      </a>
      <a
        href={`tel:${site.phone}`}
        class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-primary-foreground/30 px-7 py-4 text-base font-semibold transition hover:bg-primary-foreground/10 sm:w-auto"
      >
        Call {site.phoneDisplay}
      </a>
    </div>

    <!-- the strongest trust signal on the page, where the decision happens -->
    <figure class="measure-tight mx-auto mt-8 text-center">
      <blockquote class="text-primary-foreground/90">
        <p class="text-[0.95rem] leading-relaxed">&ldquo;{heroQuote.pull ?? heroQuote.text}&rdquo;</p>
      </blockquote>
      <figcaption class="mt-2.5 text-xs text-primary-foreground/55">
        {heroQuote.author} &middot; five stars on Google
      </figcaption>
    </figure>
  </div>
</header>
