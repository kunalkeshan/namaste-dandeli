---
/**
 * An image hotlinked from Wikimedia Commons.
 *
 * Not using astro:assets: these files are remote by choice (the "low
 * asset dependency" call), so Astro cannot optimise them at build.
 * We recover most of that by hand — a real srcset, width/height to
 * reserve space, and per-position loading hints.
 *
 * On `aspect`: width/height attributes give the browser the file's
 * INTRINSIC ratio, which is what prevents layout shift. But when we
 * also want a CSS crop, the two fight and the attributes win until
 * the image loads. So a cropped image gets `height: auto` via
 * `h-auto`, which hands the ratio to CSS while width/height still
 * tell the browser the shape. No shift, correct crop.
 */
import type { Img } from '../content';

interface Props {
  img: Img;
  sizes?: string;
  /** Tailwind aspect utility, e.g. "aspect-[5/3]". Omit to keep the file's own ratio. */
  aspect?: string;
  /** Hero only — it is the LCP element. */
  priority?: boolean;
  class?: string;
}
const {
  img,
  sizes = '100vw',
  aspect,
  priority = false,
  class: className = '',
} = Astro.props;

const cls = [aspect, aspect && 'h-auto object-cover', className]
  .filter(Boolean)
  .join(' ');

/**
 * LQIP: a ~500-byte base64 thumbnail Sanity generates per asset,
 * painted as the element's own background.
 *
 * This is what removes the blank rectangle. Sanity transcodes on the
 * first request for a given width — measured at 0.77s TTFB cold,
 * 0.24s once warm — so even a well-optimised image has a visible gap
 * on a cold CDN. The placeholder fills it with the real colours of
 * the photograph, inline in the HTML, needing no request at all.
 *
 * It costs ~0.5KB per image and is painted under the <img>, so the
 * real photo simply resolves over it.
 */
const placeholder = img.lqip
  ? `background-image:url(${img.lqip});background-size:cover;background-position:center`
  : undefined;
---

<img
  src={img.src}
  srcset={img.srcset}
  sizes={sizes}
  width={img.width}
  height={img.height}
  alt={img.alt}
  class={cls}
  loading={priority ? 'eager' : 'lazy'}
  decoding={priority ? 'sync' : 'async'}
  fetchpriority={priority ? 'high' : 'auto'}
  style={placeholder}
/>
