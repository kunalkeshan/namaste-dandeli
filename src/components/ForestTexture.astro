---
/**
 * A canopy texture for the deep-green bands.
 *
 * Drawn rather than photographed: a photo would be another hotlinked
 * dependency and would fight the real photography already on the
 * page. This is a seamless SVG pattern of leaf and branch strokes,
 * tiled by CSS — about 1KB, no request, scales to any viewport.
 *
 * ⚠️ It sits BEHIND text, so it is deliberately faint. The default
 * opacity was chosen so the computed contrast of text over the band
 * is unchanged to two decimal places — `pnpm verify:a11y` checks the
 * tokens, but a texture is not a token, so the value here was
 * measured against the rendered page instead.
 *
 * aria-hidden: it carries no information.
 */
interface Props {
  /** 0.03–0.07 is the usable range. Above that, text contrast moves. */
  opacity?: number;
  class?: string;
}
const { opacity = 0.05, class: className = '' } = Astro.props;

/* One tile. Strokes are foliage seen from underneath — the view from
   a car window on the Ganeshgudi road, which is what the section
   photography shows. */
const tile = `
<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180' viewBox='0 0 180 180'>
  <g fill='none' stroke='%23ffffff' stroke-width='1.1' stroke-linecap='round'>
    <path d='M0 34 C 22 26, 40 38, 58 30 C 76 22, 92 34, 112 28 C 132 22, 150 34, 180 26'/>
    <path d='M-10 96 C 14 88, 30 100, 50 92 C 70 84, 88 96, 108 90 C 128 84, 150 96, 190 88'/>
    <path d='M0 152 C 20 146, 36 158, 56 150 C 78 142, 96 154, 118 148 C 140 142, 158 154, 180 146'/>
  </g>
  <g fill='%23ffffff'>
    <ellipse cx='28' cy='22' rx='9' ry='4' transform='rotate(-24 28 22)'/>
    <ellipse cx='74' cy='40' rx='8' ry='3.5' transform='rotate(18 74 40)'/>
    <ellipse cx='126' cy='18' rx='9.5' ry='4' transform='rotate(-12 126 18)'/>
    <ellipse cx='46' cy='84' rx='8.5' ry='3.5' transform='rotate(30 46 84)'/>
    <ellipse cx='98' cy='102' rx='9' ry='4' transform='rotate(-20 98 102)'/>
    <ellipse cx='152' cy='80' rx='8' ry='3.5' transform='rotate(14 152 80)'/>
    <ellipse cx='20' cy='142' rx='9' ry='4' transform='rotate(22 20 142)'/>
    <ellipse cx='84' cy='160' rx='8.5' ry='3.5' transform='rotate(-16 84 160)'/>
    <ellipse cx='142' cy='136' rx='9' ry='4' transform='rotate(26 142 136)'/>
  </g>
</svg>`
  .replace(/\s+/g, ' ')
  .trim();

const dataUri = `url("data:image/svg+xml,${tile}")`;
---

<div
  aria-hidden="true"
  class={`pointer-events-none absolute inset-0 ${className}`}
  style={`background-image:${dataUri};background-size:180px 180px;opacity:${opacity}`}
></div>
