---
import { getContent, type PageQuote } from '../content';

interface Props {
  quotes: PageQuote[];
}
const { quotes } = Astro.props;
const { site } = await getContent();
---

{quotes.length > 0 && (
  <div class="mt-10 space-y-6">
    {quotes.map((q) => {
      const shown = q.pull && q.text.includes(q.pull) ? q.pull : q.text;
      return (
        <figure class="reveal-child rounded-2xl border border-foreground/10 bg-muted/40 p-6">
          <blockquote class="measure text-lg text-foreground">"{shown}"</blockquote>
          <figcaption class="mt-3 text-sm text-muted-foreground">
            — {q.author}
            {q.dateLabel ? `, ${q.dateLabel}` : ''} on{' '}
            <a
              href={site.google.mapsUrl}
              class="link-inline"
              data-track="maps"
              data-placement="inline"
            >
              Google
            </a>
          </figcaption>
        </figure>
      );
    })}
  </div>
)}
