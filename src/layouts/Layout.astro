---
/**
 * The page shell.
 *
 * A LAYOUT in Astro wraps pages: everything common (head, fonts,
 * structured data, footer chrome) lives here so pages hold only
 * content. `<slot />` is where the page's own markup lands.
 */
import '../styles/global.css';
import { getContent } from '../content';

interface Props {
  title: string;
  description: string;
  /**
   * Preload the hero image. ON by default, because the homepage is the
   * page this shell was built for and the hero IS its LCP element.
   *
   * Legal pages pass false. A `rel=preload as=image
   * fetchpriority=high` for an image the page never renders is not
   * merely wasted bytes — it is a high-priority request competing with
   * the font stylesheets for the same connection, so it makes the legal
   * page's real LCP (its <h1>) arrive later. Chrome also logs an
   * unused-preload warning.
   */
  preloadHero?: boolean;
  /**
   * Schema.org @type for this page's WebPage node. Legal pages are
   * `WebPage`; the homepage omits it and keeps the WebSite node alone.
   */
  pageType?: 'WebPage';
  /**
   * The page's own name for the breadcrumb and the WebPage node.
   *
   * Separate from `title`, which carries the " — Namaste Dandeli"
   * suffix that belongs in a browser tab and reads wrong as the last
   * crumb of a trail. Defaults to `title` when not given.
   */
  pageName?: string;
}
const { title, description, preloadHero = true, pageType, pageName } = Astro.props;
const crumbName = pageName ?? title;
const { site, images } = await getContent();

/**
 * The hero is the LCP element. `fetchpriority="high"` on the <img>
 * only helps once the browser has FOUND it, which is after CSS. A
 * preload moves discovery into the head.
 *
 * imagesrcset/imagesizes must mirror the <img> exactly — a preload
 * that disagrees with the candidate the browser eventually picks
 * downloads the image twice, which is slower than no preload at all.
 */
const heroImg = preloadHero ? images.rafting : null;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://namastedandeli.com');

/**
 * Structured data.
 *
 * NOTE the deliberate omission: there is NO `aggregateRating` here.
 * Google's policy makes a business marking up reviews about itself
 * ineligible for star snippets, and explicitly bars aggregating
 * ratings from other sites. Including it renders nothing — pure
 * downside. The 4.9 is shown as visible HTML instead, which is both
 * allowed and what actually converts.
 */
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['LocalBusiness', 'TaxiService'],
      '@id': `${canonical.origin}/#business`,
      name: site.name,
      alternateName: [site.legalName, site.googleName],
      description,
      url: canonical.origin,
      telephone: site.phone,
      email: site.email,
      image: `${canonical.origin}/og.jpg`,
      /* The monogram on transparency, which is what Google wants for a
         knowledge panel — og.jpg is a 1200x630 card, not a logo. */
      logo: `${canonical.origin}/logo.png`,
      priceRange: '₹₹',
      address: {
        '@type': 'PostalAddress',
        streetAddress: site.address.street,
        addressLocality: site.address.locality,
        addressRegion: site.address.region,
        postalCode: site.address.postalCode,
        addressCountry: site.address.country,
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: site.address.lat,
        longitude: site.address.lng,
      },
      areaServed: site.serviceAreas.map((n: string) => ({ '@type': 'Place', name: n })),
      sameAs: [site.google.mapsUrl],
    },
    {
      '@type': 'WebSite',
      '@id': `${canonical.origin}/#website`,
      url: canonical.origin,
      name: site.name,
      publisher: { '@id': `${canonical.origin}/#business` },
      inLanguage: 'en-IN',
    },
    /**
     * A WebPage node for subpages, with a breadcrumb back to the home
     * page.
     *
     * Only emitted when a page asks for it, so the homepage graph is
     * unchanged: on `/` a WebPage node whose `isPartOf` is the WebSite
     * and whose breadcrumb is a single "Home" item says nothing a
     * crawler cannot already infer, and the WebSite node already
     * carries the homepage's identity.
     *
     * Still no `aggregateRating` anywhere — see the note above.
     */
    ...(pageType
      ? [
          {
            '@type': pageType,
            '@id': `${canonical.href}#webpage`,
            url: canonical.href,
            name: crumbName,
            description,
            isPartOf: { '@id': `${canonical.origin}/#website` },
            about: { '@id': `${canonical.origin}/#business` },
            inLanguage: 'en-IN',
            breadcrumb: { '@id': `${canonical.href}#breadcrumb` },
          },
          {
            '@type': 'BreadcrumbList',
            '@id': `${canonical.href}#breadcrumb`,
            itemListElement: [
              {
                '@type': 'ListItem',
                position: 1,
                name: 'Home',
                item: canonical.origin,
              },
              { '@type': 'ListItem', position: 2, name: crumbName },
            ],
          },
        ]
      : []),
  ],
};
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content="en_IN" />
    <!-- Generated by `pnpm og`. Regenerate when the review count moves. -->
    <meta property="og:image" content={new URL('/og.jpg', canonical.origin).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${site.name}: cabs, trips and stays across Dandeli`}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og.jpg', canonical.origin).href} />
    <meta name="theme-color" content="#0F3D2E" />

    <!-- Fonts. preconnect first so the handshake overlaps parsing. -->
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,700&f[]=bespoke-serif@700,800&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@600;700&display=swap"
    />
    <!--
      Images are hotlinked from Commons, which 302s from
      commons.wikimedia.org to thumb.wikimedia.org — two hosts, two
      round-trips. We previously warmed `upload.` which never serves
      the bytes; `thumb.` is the one that does.
    -->
    <link rel="preconnect" href="https://commons.wikimedia.org" />
    <link rel="preconnect" href="https://thumb.wikimedia.org" crossorigin />

    <!-- Discover the LCP image in the head, not after CSS. Omitted on
         pages with no hero: an unused high-priority preload competes
         with the font CSS and delays the real LCP. -->
    {heroImg && (
      <link
        rel="preload"
        as="image"
        href={heroImg.src}
        imagesrcset={heroImg.srcset}
        imagesizes="100vw"
        fetchpriority="high"
      />
    )}

    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-primary focus:text-primary-foreground focus:px-4 focus:py-2 focus:rounded"
    >
      Skip to content
    </a>
    <slot />
  </body>
</html>
