---
/**
 * The fleet.
 *
 * Each card leads with the commissioned illustration of Irshad beside
 * that vehicle, served from Sanity's CDN with a responsive srcset.
 *
 * All three illustrations are 3:2, so the frame is a fixed
 * aspect-[3/2] — the old cutouts were three different ratios
 * (1014x569, 590x411, 1100x658), which is why the cards never lined
 * up. Transparent PNG over the card gradient.
 *
 * Motion is CSS only, gated behind (hover:hover) by the global
 * .img-zoom rule: no JS, and the zero-.js gate stays green.
 *
 * WHY THE SUITS PARAGRAPH GROWS AND THE NOTE RESERVES HEIGHT
 *
 * The note used to carry `mt-auto`, which hands every card's leftover
 * height to the margin ABOVE the rule. The card with the longest copy
 * has no leftover height, so its rule sat flush against the text while
 * the others floated — three cards, three different gaps.
 *
 * So `flex-1` moves to the suits paragraph: it becomes the one
 * flexible item, the slack inflates its box instead of the note's
 * margin, and the gap above every rule is a fixed mt-5 + pt-4 for any
 * number of vehicles and any length of copy.
 *
 * The `min-h` then keeps the rules on one line when one note wraps to
 * an extra line, by making a short note reserve the tall one's height.
 * It is `1rem` (the pt-4) plus three line boxes — `lh` is the
 * element's OWN computed line-height, so it tracks the type scale
 * rather than hardcoding a pixel. The +1px is real: three rendered
 * lines measure a fraction over 3lh because each line box rounds up
 * around its glyphs, and without it the tallest note sits one pixel
 * above its own floor.
 */
import Section from './Section.astro';
import { getContent } from '../content';
const { vehicles, carImages, carImageNote, copy } = await getContent();
---

<Section
  id="cars"
  eyebrow={copy.sections.cars.eyebrow}
  title={copy.sections.cars.title}
  tone="muted"
>
  <div class="reveal grid gap-6 sm:grid-cols-3">
    {vehicles.map((v) => {
      const img = v.photos[0];
      return (
        <article class="reveal-child group flex flex-col overflow-hidden rounded-xl border border-border bg-background">
          <div class="flex aspect-[3/2] items-center justify-center bg-gradient-to-b from-muted to-background px-4">
            <img
              src={img?.src}
              srcset={img?.srcset}
              sizes="(min-width: 640px) 30vw, 90vw"
              width={img?.width}
              height={img?.height}
              alt={img?.alt}
              loading="lazy"
              decoding="async"
              class="h-32 w-auto object-contain transition-transform duration-500 ease-out motion-safe:group-hover:-translate-y-1 motion-safe:group-hover:scale-[1.04]"
            />
          </div>
          <div class="flex flex-1 flex-col gap-0 p-6 pt-4">
            <h3 class="text-xl">{v.name}</h3>
            <p class="decal mt-1.5 text-xs text-accent-ink">{v.seats}</p>
            <p class="mt-3 flex-1 text-muted-foreground">{v.suits}</p>
            <p class="mt-5 min-h-[calc(1rem+3lh+1px)] border-t border-rule pt-4 text-sm text-muted-foreground">
              {v.note}
            </p>
          </div>
        </article>
      );
    })}
  </div>

  <p class="reveal mt-6 text-sm text-muted-foreground">{carImageNote}</p>
</Section>
