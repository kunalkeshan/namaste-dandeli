---
import { getContent } from '../../content';
import MarketingDocument from '../../components/MarketingDocument.astro';

const { marketingHub, marketingChildren } = await getContent();
const page = marketingHub('things-to-do');
if (!page) throw new Error('things-to-do hub is missing or unpublished');
const children = marketingChildren('things-to-do');
---

<MarketingDocument
  page={page}
  breadcrumbs={[{ name: 'Things to do' }]}
  children={children}
/>
