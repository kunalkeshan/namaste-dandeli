---
/**
 * The ND monogram — Airsaat's original artwork, vector-traced.
 *
 * This replaces a hand redraw. The source the designer delivered
 * (`source-logo.webp`) is a 1588px greyscale raster: black ink, no
 * colour information at all. The two letters were separated by
 * connected-component analysis — the N's swash and upright form two
 * blobs, the D's stem, bowl and hairline three more — and each group
 * was traced to a single path. `scripts/trace-logo.mjs` reproduces
 * this and FAILS if the source's topology ever changes, because the
 * colour split is keyed to it.
 *
 * Colour follows Irshad's signboard exactly: the N is red, the D is
 * white. The D is a literal #FFFFFF, NOT `currentColor` — the mark
 * is only ever placed on a dark band, and the one light-background
 * placement (the style guide) carries its own dark plate. A
 * `currentColor` D would have been a quieter bug: it renders
 * invisible, not wrong.
 *
 * Draw order is load-bearing: the N goes down first so the D's top
 * serif cuts across the swash, which is how the sign is layered.
 *
 * ONE red group, so each rendered logo contributes exactly one
 * `#C3160D` to the HTML — `verify-content` counts them.
 *
 * Outlines, not live text: a logo must not reflow if a webfont fails.
 */
interface Props {
  class?: string;
  title?: string;
}
const { class: className = '', title = 'Namaste Dandeli' } = Astro.props;
---

