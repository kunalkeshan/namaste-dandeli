---
/**
 * Travelling alone.
 *
 * Solo female travel safety is a real and underserved concern in
 * Indian tourism, and his reviews evidence it rather than claim it.
 *
 * ⚠️ The three assurances that used to be hardcoded here were
 * promises made on Irshad's behalf — that he always drives, that he
 * sends the vehicle number before pickup, that one number is always
 * answered. None is confirmed, so none renders. The section instead
 * shows only what is independently checkable: his public listing and
 * his reviews.
 *
 * Confirm them in content/assurances.ts and they appear automatically.
 */
import { getContent, whatsappLink } from '../content';
import { isConfirmed } from '../content/confirmed';

const { featuredReview, assurances, soloFallback, copy } = await getContent();

/* Unconfirmed assurances are OMITTED, not hedged — a softened safety
   promise is worse than none at all. */
const confirmedAssurances = assurances.filter(isConfirmed).map((a) => a.value);
const points =
  confirmedAssurances.length > 0 ? confirmedAssurances : soloFallback.evidence;
---

<section id="solo" class="bg-background">
  <div class="mx-auto max-w-5xl px-5 py-16 sm:py-24">
    <div class="grid gap-12 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
      <div class="reveal">
        <p class="decal text-xs text-accent-ink">{copy.sections.solo.eyebrow}</p>
        <h2 class="mt-3 text-2xl">{soloFallback.title}</h2>
        <p class="measure mt-4 text-lg text-muted-foreground">{soloFallback.lede}</p>

        <ul class="mt-8 space-y-6">
          {points.map((p) => (
            <li class="reveal-child">
              <h3 class="font-display text-lg">{p.title}</h3>
              <p class="measure mt-1.5 text-muted-foreground">{p.body}</p>
            </li>
          ))}
        </ul>
      </div>

      <figure class="sticky-col reveal self-start rounded-xl border border-border bg-muted p-7">
        <div class="text-accent-ink" aria-hidden="true">
          ★★★★★
        </div>
        <blockquote class="mt-3">
          <p class="font-display text-xl leading-snug">
            &ldquo;{featuredReview.text}&rdquo;
          </p>
        </blockquote>
        <figcaption class="mt-4 text-sm text-muted-foreground">
          {featuredReview.author} &middot; {featuredReview.dateLabel} &middot; on Google
        </figcaption>
        <a
          href={whatsappLink(copy.waMessages.solo)}
          target="_blank"
          rel="noopener"
          class="btn btn-primary mt-6 inline-flex w-full items-center justify-center rounded-xl bg-primary px-5 py-3.5 font-semibold text-primary-foreground"
        >
          {copy.sections.solo.cta}
        </a>
      </figure>
    </div>
  </div>
</section>
