---
/**
 * Reviews.
 *
 * Verbatim, typos intact — "confortable", "Susuki", "bcos" are how
 * these customers wrote, and editing a testimonial is fabricating one.
 *
 * The 4.9 is VISIBLE HTML, deliberately not aggregateRating schema:
 * Google ignores self-reported ratings for star snippets, so the
 * markup would render nothing. Shown here, it converts.
 */
import Section from './Section.astro';
import { getContent } from '../content';
const { reviews, site } = await getContent();
/* Skip the two quoted elsewhere: solo-safety (its own section) and
   local-knowledge (the hero). No quote appears twice on the page. */
const shownAbove = new Set(['solo-safety', 'local-knowledge']);
const rest = reviews.filter((r) => !shownAbove.has(r.role));
---

<Section
  id="reviews"
  eyebrow="What people say"
  title={`${site.google.rating} out of 5, from ${site.google.reviewCount} people`}
  lede="Every one of these is on Google under his listing, and he has replied to all of them for three years running."
  tone="dark"
>
  <div class="grid gap-6 sm:grid-cols-2">
    {rest.map((r) => (
      <figure class="flex flex-col rounded-xl border border-primary-foreground/15 bg-primary-foreground/5 p-6">
        <div class="text-accent-bright" aria-label={`${r.rating} out of 5 stars`}>
          <span aria-hidden="true">★★★★★</span>
        </div>
        <blockquote class="mt-3 flex-1">
          <p class="text-[0.95rem] leading-relaxed text-primary-foreground/90">
            &ldquo;{r.text}&rdquo;
          </p>
        </blockquote>
        <figcaption class="mt-4 text-sm text-primary-foreground/55">
          {r.author} &middot; {r.dateLabel}
        </figcaption>
      </figure>
    ))}
  </div>

  <a
    href={site.google.mapsUrl}
    target="_blank"
    rel="noopener"
    class="link-inline mt-8 inline-flex items-center gap-2 font-medium underline decoration-accent decoration-2 underline-offset-4 hover:no-underline"
  >
    Read all {site.google.reviewCount} on Google
  </a>
</Section>
