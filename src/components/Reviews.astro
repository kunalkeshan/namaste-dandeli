---
/**
 * Reviews.
 *
 * Verbatim, typos intact — "confortable", "Susuki", "bcos" are how
 * these customers wrote, and editing a testimonial is fabricating one.
 *
 * The 4.9 is VISIBLE HTML, deliberately not aggregateRating schema:
 * Google ignores self-reported ratings for star snippets, so the
 * markup would render nothing. Shown here, it converts.
 */
import Section from './Section.astro';
import { getContent } from '../content';
const { reviews, site, copy } = await getContent();
/* Skip the three quoted elsewhere: solo-safety (its own section),
   local-knowledge (the hero) and long-distance (the Routes proof).
   No customer's words appear twice on the page. */
const shownAbove = new Set(['solo-safety', 'local-knowledge', 'long-distance']);
const rest = reviews.filter((r) => !shownAbove.has(r.role));
---

<Section
  id="reviews"
  eyebrow={copy.sections.reviews.eyebrow}
  title={`${site.google.rating} out of 5, from ${site.google.reviewCount} people`}
  lede={copy.sections.reviews.lede}
  tone="dark"
>
  <div class="reveal grid gap-6 sm:grid-cols-2">
    {rest.map((r) => (
      <figure class="reveal-child flex flex-col rounded-xl border border-primary-foreground/15 bg-primary-foreground/5 p-6">
        <div class="text-accent-bright" aria-label={`${r.rating} out of 5 stars`}>
          <span aria-hidden="true">★★★★★</span>
        </div>
        <blockquote class="mt-3 flex-1">
          <p class="text-[0.95rem] leading-relaxed text-primary-foreground/90">
            &ldquo;{r.text}&rdquo;
          </p>
        </blockquote>
        <figcaption class="mt-4 text-sm text-primary-foreground/55">
          {r.author} &middot; {r.dateLabel}
        </figcaption>
      </figure>
    ))}
  </div>

  <a
    href={site.google.mapsUrl}
    target="_blank"
    rel="noopener"
    class="link-inline btn mt-8 inline-flex items-center gap-2 font-medium underline decoration-accent decoration-2 underline-offset-4 transition-opacity hover:opacity-80 hover:no-underline"
  >
    Read all {site.google.reviewCount} on Google
  </a>
</Section>
